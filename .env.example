# Optional: Spline scene URL for the 3D hero. Leave unset to use the hand-built coin fallback.
VITE_SPLINE_SCENE_URL=

# Optional: cloud sync across devices (see supabase/schema.sql). Leave unset to keep data in this browser only.
# Project URL and publishable (or anon) key from Supabase → Project Settings → API. Both are safe to ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
